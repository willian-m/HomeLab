---
- name: Setup VM with Tailscale
  hosts: omv
  become: yes

  vars:
    tailscale_auth_key: "${tailscale_auth_key}"
    target_user: "${username}"

  tasks:
    # Update package cache
    - name: Update apt cache (Debian/Ubuntu)
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"

    # Install Tailscale
    - name: Download Tailscale install script
      get_url:
        url: https://tailscale.com/install.sh
        dest: /tmp/tailscale-install.sh
        mode: '0755'

    - name: Install Tailscale using official script
      shell: /tmp/tailscale-install.sh
      args:
        creates: /usr/bin/tailscale

    - name: Enable and start Tailscale service
      systemd:
        name: tailscaled
        enabled: yes
        state: started

    - name: Check if Tailscale is already connected
      command: tailscale status
      register: tailscale_status
      changed_when: false
      failed_when: false

    - name: Connect to Tailscale network
      command: "tailscale up --authkey={{ tailscale_auth_key }}"
      when: 
        - tailscale_auth_key | length > 0
        - tailscale_status.rc != 0


- name: Setup OpenMediaVault
  hosts: omv
  become: yes

  vars:
    target_user: "${username}"

  tasks:
     # Update package cache
    - name: Update apt cache (Debian/Ubuntu)
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"

    - name: Install OpenMediaVault
      ansible.builtin.shell: |
        export LANG=C.UTF-8
        export DEBIAN_FRONTEND=noninteractive
        export APT_LISTCHANGES_FRONTEND=none
        apt-get --yes --auto-remove --show-upgraded \
          --allow-downgrades --allow-change-held-packages \
          --no-install-recommends \
          --option DPkg::Options::="--force-confdef" \
          --option DPkg::Options::="--force-confold" \
          install openmediavault
          omv-confdbadm populate
          omv-salt deploy run systemd-networkd
      register: omv_install_result
      changed_when: "'is already the newest version' not in omv_install_result.stdout"

    - name: Install jq for JSON parsing
      apt:
        name: jq
        state: present

    - name: Ensure storage directory has correct permissions
      file:
        path: "/home/{{ target_user }}/omv-storage"
        owner: "{{ target_user }}"
        group: "{{ target_user }}"
        mode: '0775'
        state: directory

    # --- Register NFS share in OMV WebUI ---

    - name: Register storage mount point in OMV database
      ansible.builtin.shell: |
        set -euo pipefail
        # Try to create the bind mount entry; if it already exists, fetch its UUID
        RESULT=$(sudo omv-rpc "FsTab" "set" "{
          \"uuid\": \"fa4b1c66-ef79-11e5-87a0-0002b3a176b4\",
          \"fsname\": \"/home/{{ target_user }}/omv-storage\",
          \"dir\": \"/home/{{ target_user }}/omv-storage\",
          \"type\": \"none\",
          \"opts\": \"bind,nofail\",
          \"freq\": 0,
          \"passno\": 0
        }" 2>&1 || true)

        if [ "$(echo $RESULT | jq -r '.error')" != null ]; then
          # Retrieve existing UUID
          echo $(sudo omv-confdbadm read "conf.system.filesystem.mountpoint" | jq '.[] | select(.fsname == "/home/wmatioli/omv-storage") | .uuid')
          exit 0
        fi
        echo "$(echo $RESULT | jq -r '.uuid')"
        exit 0

      args:
        executable: /bin/bash
      register: fstab_result
      changed_when: fstab_result.stdout_lines | length > 0

    - name: Create shared folder in OMV
      ansible.builtin.shell: |
        set -euo pipefail
        MNTENT_UUID="{{ fstab_result.stdout_lines[-1] }}"
        # Check if shared folder 'omv-storage' already exists
        EXISTING=$(sudo omv-rpc "ShareMgmt" "enumerateSharedFolders" '{}' \
          | jq -r '.[] | select(.name=="omv-storage") | .uuid')
        if [ -n "$EXISTING" ]; then
          echo "$EXISTING"
          exit 0
        fi
        RESULT=$(sudo omv-rpc "ShareMgmt" "set" "{
          \"uuid\": \"fa4b1c66-ef79-11e5-87a0-0002b3a176b4\",
          \"name\": \"omv-storage\",
          \"reldirpath\": \"/\",
          \"comment\": \"K3s NFS storage\",
          \"mntentref\": \"$MNTENT_UUID\",
          \"mode\": \"775\"
        }")
        echo "$RESULT" | jq -r '.uuid'
      args:
        executable: /bin/bash
      register: sharedfolder_result
      changed_when: sharedfolder_result.stdout_lines | length > 0

    - name: Enable NFS service in OMV
      ansible.builtin.shell: |
        set -euo pipefail
        # Get current settings and merge in only the fields we need
        CURRENT=$(sudo omv-rpc "NFS" "getSettings" '{}')
        UPDATED=$(echo "$CURRENT" | jq '. + {"enable": true, "versions": ["3","4"]}')
        sudo omv-rpc "NFS" "setSettings" "$UPDATED"
      args:
        executable: /bin/bash
      changed_when: true

    - name: Create NFS share in OMV
      ansible.builtin.shell: |
        set -euo pipefail

        SF_UUID="{{ sharedfolder_result.stdout_lines[-1] }}"
        # Check if NFS share already exists for this shared folder
        EXISTING=$(sudo omv-rpc "NFS" "getShareList" \
          '{"start":0,"limit":100,"sortfield":"sharedfoldername","sortdir":"ASC"}' \
          | jq -r ".data[] | select(.sharedfolderref==\"$SF_UUID\") | .uuid")
        if [ -n "$EXISTING" ]; then
          echo "NFS share already exists: $EXISTING"
          exit 0
        fi
        MNTENT_UUID="{{ fstab_result.stdout_lines[-1] }}"
        sudo omv-rpc "NFS" "setShare" "{
          \"uuid\": \"fa4b1c66-ef79-11e5-87a0-0002b3a176b4\",
          \"sharedfolderref\": \"$SF_UUID\",
          \"client\": \"*\",
          \"options\": \"rw\",
          \"comment\": \"K3s NFS storage\",
          \"extraoptions\": \"subtree_check,insecure,no_root_squash\",
          \"mntentref\": \"$MNTENT_UUID\"
        }"
      args:
        executable: /bin/bash
      register: nfs_share_result
      changed_when: "'already exists' not in nfs_share_result.stdout"

    - name: Apply OMV configuration changes
      ansible.builtin.shell: |
        set -euo pipefail
        sudo omv-rpc "Config" "applyChanges" '{"modules":[],"force":false}'
      args:
        executable: /bin/bash
      changed_when: true
