# Local, uncommitted config for access-token.sh. Copy to cloudflare.env.
#
# CF_API_TOKEN: create at https://dash.cloudflare.com/profile/api-tokens
#   Use a Custom Token with this single permission (least privilege):
#     Account -> Access: Service Tokens -> Edit
#   Scope it to your account. It does NOT need zone or any other access.
#
# CF_ACCOUNT_ID: shown in the Cloudflare dashboard URL and on any zone's
#   Overview page (right-hand sidebar, "Account ID").
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
