---
# Copy this file to secret.yml and paste in the tunnel credentials, then run
# ./seal.sh to generate 01-sealed-secret.yml (the only secret file committed).
#
# How to obtain the credentials from the Cloudflare dashboard (no local CLI):
#   1. Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared.
#      Name it (e.g. "homelab") and save. Skip the "Public Hostnames" step
#      (routing is done locally via the ConfigMap).
#   2. On the install screen, copy the token (the long string after
#      "--token" in the shown command). Do NOT install anything.
#   3. Decode it to get the three fields:
#        echo "<TOKEN>" | base64 -d
#      That prints: {"a":"<AccountTag>","s":"<TunnelSecret>","t":"<TunnelID>"}
#   4. Remap the fields into credentials.json below:
#        a -> AccountTag,  s -> TunnelSecret,  t -> TunnelID
#   5. Put the same TunnelID (t) into config.env as TUNNEL_ID.
apiVersion: v1
kind: Secret
metadata:
  name: tunnel-credentials
  namespace: cloudflared
type: Opaque
stringData:
  credentials.json: |
    {"AccountTag":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","TunnelSecret":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","TunnelID":"00000000-0000-0000-0000-000000000000"}
