# Local, uncommitted values used to render 02-configmap.yml via ./gen-config.sh.
# Copy this file to config.env (gitignored) and fill in your real values.
#
# Every KEY=value here is substituted into the matching __KEY__ placeholder in
# 02-configmap.yml.tmpl. To expose another service, add a new hostname var (e.g.
# DOMAIN_FOO=foo.mydomain.com) and reference __DOMAIN_FOO__ in the template -- no
# script changes, and the hostname stays out of git.
#
# DOMAIN     Public hostname your family will use, e.g. immich.mydomain.com
# TUNNEL_ID  Tunnel ID from the Cloudflare dashboard. Must match the TunnelID
#            inside secret.yml's credentials.json.
DOMAIN=immich.example.com
TUNNEL_ID=00000000-0000-0000-0000-000000000000
