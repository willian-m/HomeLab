---
# Copy this file to secret.yml and fill in the OAuth client credentials, then
# run ./seal.sh to generate 01-sealed-secret.yml (the only file that is committed).
#
# Create the OAuth client in the Tailscale admin console
# (https://login.tailscale.com/admin/settings/oauth) with these scopes:
#   - Devices Core: write
#   - Auth Keys:    write
# and tag it tag:k8s-operator.
apiVersion: v1
kind: Secret
metadata:
  name: operator-oauth
  namespace: tailscale
type: Opaque
stringData:
  client_id: "tskey-client-xxxxxxxxxxxx"
  client_secret: "tskey-client-secret-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
